# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB ----
# IMPORTANT: checkout uses multi-document transactions, which require a
# replica-set deployment (Atlas clusters are replica sets by default).
#
# Atlas — SRV form (preferred when Node can do SRV lookups):
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/ecommerce_checkout?retryWrites=true&w=majority
#
# Atlas — "standard" form. Use this when Node cannot resolve SRV/TXT records
# (symptom at startup: "querySrv ECONNREFUSED _mongodb._tcp.<cluster-host>" —
# some Windows/VPN DNS setups point Node's c-ares resolver at 127.0.0.1).
# Host list + replica set name come from:
#   nslookup -type=SRV _mongodb._tcp.<cluster-host>
#   nslookup -type=TXT  <cluster-host>
#   MONGO_URI=mongodb://<user>:<password>@<shard-00-00>:27017,<shard-00-01>:27017,<shard-00-02>:27017/ecommerce_checkout?tls=true&replicaSet=<rs-name>&authSource=admin&retryWrites=true&w=majority
#
# Local dev (single-node replica set, started once):
#   "C:\Program Files\MongoDB\Server\8.3\bin\mongod.exe" --replSet rs0 --port 27018 --dbpath C:\data\rs0 --bind_ip 127.0.0.1
#   then initiate once: rs.initiate({_id:"rs0",members:[{_id:0,host:"127.0.0.1:27018"}]})
MONGO_URI=mongodb://127.0.0.1:27018/ecommerce_checkout?replicaSet=rs0

# ---- JWT Authentication ----
JWT_SECRET=replace-this-with-a-long-random-secret-string
JWT_EXPIRES_IN=30d

# ---- CORS ----
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# ---- Checkout / reservation policy ----
RESERVATION_EXPIRY_MINUTES=5

# ---- Rate limits (requests per minute) ----
CHECKOUT_RATE_LIMIT_MAX=20
PAYMENT_RATE_LIMIT_MAX=15

# ---- Mock payment gateway ----
# How long the simulated "timeout" payment takes to resolve (seconds)
PAYMENT_TIMEOUT_SECONDS=6
